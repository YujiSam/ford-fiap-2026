# Copie para .env (NUNCA faça commit do .env) e troque TODOS os valores.
ENV=dev
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=TROQUE_ME
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotação: coloque a chave nova PRIMEIRA e mantenha a antiga depois da vírgula.
FERNET_KEYS=TROQUE_ME
# Senhas com no mínimo 12 caracteres
ANALISTA_PASSWORD=TROQUE_ME
ADMIN_PASSWORD=TROQUE_ME
# Token do Prometheus (>= 24 caracteres)
METRICS_TOKEN=TROQUE_ME
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_MINUTES=15
